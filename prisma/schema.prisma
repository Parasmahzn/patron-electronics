// Prisma schema for Patron Electronics
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Admin authentication
// ---------------------------------------------------------------------------

model Admin {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions AdminSession[]
}

// Server-side session record. The raw session token lives only in the
// HTTP-only cookie; only its SHA-256 hash is persisted so a database leak
// cannot be used to reconstruct valid session cookies.
model AdminSession {
  id           Int      @id @default(autoincrement())
  tokenHash    String   @unique
  adminId      Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
}

// Persistent login-attempt counter so rate limiting survives server
// restarts. Keyed by a client identifier (e.g. IP address).
model LoginAttempt {
  id            Int      @id @default(autoincrement())
  identifier    String   @unique
  attemptCount  Int      @default(0)
  firstAttempAt DateTime @default(now())
  lockedUntil   DateTime?
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum ProductType {
  MOBILE
  LAPTOP
  ACCESSORY
  GADGET
}

model Category {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String?  @db.Text
  image        String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  products Product[]

  @@index([isActive, displayOrder])
}

// Homepage hero carousel slides. `image` is required (unlike Category/Service,
// a banner with no image isn't a banner); `linkUrl` is a plain string rather
// than a validated URL type so it can hold relative internal paths
// (/products/foo, /shop?category=bar) as well as full external URLs.
model Banner {
  id           Int      @id @default(autoincrement())
  title        String
  image        String
  linkUrl      String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model Product {
  id                Int         @id @default(autoincrement())
  name              String
  slug              String      @unique
  sku               String      @unique
  brand             String
  description       String      @db.Text
  shortDescription  String
  price             Decimal     @db.Decimal(10, 2)
  discountPrice     Decimal?    @db.Decimal(10, 2)
  stock             Int         @default(0)
  lowStockThreshold Int         @default(5)
  warranty          String?
  tags              String?     @db.Text
  productType       ProductType

  isNew         Boolean @default(false)
  isFeatured    Boolean @default(false)
  isBestSeller  Boolean @default(false)
  isTopSale     Boolean @default(false)
  isRecommended Boolean @default(false)
  isOnSale      Boolean @default(false)
  isActive      Boolean @default(true)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images         ProductImage[]
  specifications ProductSpecification[]
  orderItems     OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([brand])
  @@index([name])
  @@index([price])
  @@index([createdAt])
  @@index([stock])
  @@index([isActive, categoryId])
  @@index([isActive, createdAt])
}

model ProductImage {
  id           Int     @id @default(autoincrement())
  productId    Int
  url          String
  alt          String
  sortOrder    Int     @default(0)
  isPrimary    Boolean @default(false)

  // Present only for images that went through the managed upload pipeline.
  // Null for legacy/seed-generated images and manually-typed external URLs.
  storageKey   String?  @unique
  originalName String?
  mimeType     String?
  fileSize     Int?
  width        Int?
  height       Int?
  format       String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpecification {
  id           Int    @id @default(autoincrement())
  productId    Int
  label        String
  value        String
  displayOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------------------------------
// Services & repair requests
// ---------------------------------------------------------------------------

model Service {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  description      String   @db.Text
  shortDescription String
  image            String?
  startingPrice    Decimal? @db.Decimal(10, 2)
  displayOrder     Int      @default(0)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive, displayOrder])
}

enum RepairStatus {
  REQUESTED
  DIAGNOSING
  WAITING_FOR_CUSTOMER
  REPAIRING
  READY
  COMPLETED
  CANCELLED
}

model RepairRequest {
  id            Int          @id @default(autoincrement())
  requestNumber String       @unique
  name          String
  phone         String
  deviceType    String
  brand         String
  model         String
  problem       String       @db.Text
  notes         String?      @db.Text
  internalNotes String?      @db.Text
  status        RepairStatus @default(REQUESTED)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([phone])
  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  READY_FOR_DELIVERY
  SHIPPED
  DELIVERED
  CANCELLED
}

model Order {
  id            Int      @id @default(autoincrement())
  orderNumber   String   @unique
  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  city          String?
  area          String?
  notes         String?  @db.Text

  subtotal    Decimal @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  paymentMethod PaymentMethod @default(COD)
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(PENDING)

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerPhone])
  @@index([createdAt])
  @@index([orderStatus])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  productId   Int?
  productName String
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

model Review {
  id         Int      @id @default(autoincrement())
  authorName String
  rating     Int
  comment    String   @db.Text
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isVisible, createdAt])
}

// ---------------------------------------------------------------------------
// Storefront settings (singleton row, id = 1)
// ---------------------------------------------------------------------------

model SiteSettings {
  id               Int      @id @default(1)
  businessName     String   @default("Patron Electronics")
  phone            String   @default("9843012697")
  address          String   @default("P9MJ+8J6, Gokarneshwor 44600, Nepal")
  announcementText String?  @default("Free diagnostics on all repair bookings this week")
  heroHeading      String   @default("Your Trusted Mobile & Laptop Store")
  heroSubheading   String   @default("Quality devices, accessories, professional repairs, and reliable service — all in one place.")
  aboutText        String?  @db.Text
  updatedAt        DateTime @updatedAt
}

// Footer social media links. A flat, admin-manageable list (not one column
// per platform) so a brand-new platform is just a new row, never a schema
// change — `platform` is a free-text key ('facebook', 'instagram', ... or
// anything an admin types); unrecognized keys fall back to a generic icon
// in the UI rather than failing. Not FK'd to SiteSettings — same reasoning
// as Category/Service/Banner: a standalone site-wide list, not scoped to
// another row.
model SocialLink {
  id           Int      @id @default(autoincrement())
  platform     String
  url          String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
}
