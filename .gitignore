# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editor/IDE
.vscode/*
!.vscode/extensions.json
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — .env.example is a template with no real secrets and must stay
# committed (see CLAUDE.md section 69); every other .env* variant is ignored.
.env*
!.env.example

# vercel
.vercel

# runtime-uploaded product/category/service images (see lib/uploads/) — never
# committed; persisted in production via a mounted volume instead. Static seed
# placeholder images live in public/seed/, not here.
/public/images/

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# auto-generated agent-facing reference docs (e.g. Prisma's bundled skills) —
# regenerable tooling output, not hand-authored project source
.agents/
.claude/
.windsurf/
.cursor/
skills-lock.json
