DATABASE_URL="mysql://user:password@localhost:3306/patron_electronics"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password"

NODE_ENV=development

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image storage for admin uploads — any S3-compatible bucket (Railway
# buckets, Cloudflare R2, MinIO, Backblaze, DigitalOcean Spaces, AWS S3
# itself, etc.) via lib/uploads/storage/s3-image-storage.ts. All required,
# all server-side only — never exposed to the browser (no NEXT_PUBLIC_
# prefix). The bucket itself does not need to support public read access —
# objects are read back and served through app/uploads/[...path]/route.ts,
# not a direct bucket URL, so this works against private-only buckets (e.g.
# Railway Storage Buckets) too.
S3_ENDPOINT="https://your-endpoint.example.com"
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ACCESS_KEY_ID="server-side-only-never-expose-to-browser"
S3_SECRET_ACCESS_KEY="server-side-only-never-expose-to-browser"
