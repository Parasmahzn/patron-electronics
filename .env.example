DATABASE_URL="mysql://user:password@localhost:3306/patron_electronics"

AUTH_SECRET="generate-with-openssl-rand-base64-32"

ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="use-a-strong-password"

NODE_ENV=development

NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Image storage provider for admin uploads. "local" writes under
# public/images/; "s3" uses any S3-compatible bucket (Railway buckets, R2,
# MinIO, Backblaze, DigitalOcean Spaces, AWS S3 itself, etc.) via
# lib/uploads/storage/s3-image-storage.ts.
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=s3. All server-side only — never exposed to
# the browser (no NEXT_PUBLIC_ prefix). The bucket itself does not need to
# support public read access — objects are read back and served through
# app/uploads/[...path]/route.ts, not a direct bucket URL, so this works
# against private-only buckets (e.g. Railway Storage Buckets) too.
S3_ENDPOINT="https://your-endpoint.example.com"
S3_BUCKET="your-bucket-name"
S3_REGION="auto"
S3_ACCESS_KEY_ID="server-side-only-never-expose-to-browser"
S3_SECRET_ACCESS_KEY="server-side-only-never-expose-to-browser"
